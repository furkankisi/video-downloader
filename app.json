{
  "expo": {
    "name": "BitSaver Pro",
    "slug": "video-downloader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bitsaver",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0518"
    },
    "ios": {
      "bundleIdentifier": "com.furkankisi.videodownloader",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0518"
      },
      "package": "com.bitsaverpro",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://bitsaver.com"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow BitSaver Pro to access your photos to save downloaded videos.",
          "savePhotosPermission": "Allow BitSaver Pro to save videos to your gallery.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-8754966775877680~2878129487",
          "iosAppId": "ca-app-pub-8754966775877680~2878129487",
          "userTrackingUsageDescription": "Bu izin, size daha uygun ve kişiselleştirilmiş reklamlar gösterebilmemiz için gereklidir."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "90572653-fbfc-4401-856e-79117466d4d9"
      }
    },
    "owner": "furkankisi"
  }
}