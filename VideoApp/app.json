{
  "expo": {
    "name": "BitSaver Pro",
    "slug": "video-downloader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/pixel-logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/images/pixel-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0518"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.furkan.bitsaverpro",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/pixel-logo.png",
        "backgroundColor": "#0A0518"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/images/pixel-logo.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90572653-fbfc-4401-856e-79117466d4d9"
      }
    }
  }
}
